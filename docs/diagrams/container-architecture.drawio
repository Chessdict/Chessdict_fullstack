        <mxCell id="legendc" value="Solid = synchronous / stream   Dashed = async via BullMQ queue   Cylinders = durable stores&#10;All services export OTLP traces/metrics/logs to the Observability stack." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#cccccc;spacing=6;" vertex="1" parent="1">
