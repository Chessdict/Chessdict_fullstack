<mxfile host="app.diagrams.net" agent="Chessdict-Architecture" version="24.7.0">
  <diagram name="Realtime Gameplay" id="realtime-gameplay">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Realtime Gameplay — stateless gateways + engine, all state in Redis" style="text;html=1;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="15" width="820" height="30" as="geometry" />
        </mxCell>

        <mxCell id="ca" value="Client A&#10;(player, white)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="cb" value="Client B&#10;(player, black)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="cs" value="Spectators&#10;(N clients)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="150" height="60" as="geometry" /></mxCell>

        <mxCell id="lb" value="Load Balancer&#10;TLS · STICKY WebSocket&#10;(cookie / ip-hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1"><mxGeometry x="290" y="190" width="180" height="90" as="geometry" /></mxCell>

        <mxCell id="gw1" value="realtime-gateway #1&#10;Socket.IO · Zod validate&#10;auth handshake · rooms&#10;presence heartbeat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="gw2" value="realtime-gateway #2&#10;(identical, stateless)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="230" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="gw3" value="realtime-gateway #3&#10;(autoscaled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="220" height="60" as="geometry" /></mxCell>

        <mxCell id="redis" value="Redis / Dragonfly&#10;&#10;• game:{id} hash (fen, moves, clock)&#10;• presence:{userId}&#10;• Streams adapter (fan-out)&#10;• moves:{shard} command stream&#10;• pub/sub game:{id}&#10;• BullMQ queues + delayed jobs&#10;• per-game locks (SET NX)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;boundedLbl=1;backgroundOutline=1;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="300" height="270" as="geometry" /></mxCell>

        <mxCell id="eng1" value="game-engine-svc #1&#10;chess.js validate + apply&#10;authoritative clock&#10;end-condition detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1230" y="120" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="eng2" value="game-engine-svc #2&#10;(consumer group member)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1230" y="240" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="sch" value="scheduler&#10;clock-timeout · abort · grace&#10;(BullMQ delayed jobs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1230" y="330" width="230" height="70" as="geometry" /></mxCell>

        <mxCell id="queues" value="BullMQ side-effect queues → persistence-worker · rating-worker · settlement-worker · notify-worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=2" vertex="1" parent="1"><mxGeometry x="850" y="430" width="610" height="50" as="geometry" /></mxCell>

        <mxCell id="ea" style="endArrow=block;html=1;" edge="1" parent="1" source="ca" target="lb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb" style="endArrow=block;html=1;" edge="1" parent="1" source="cb" target="lb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ecs" style="endArrow=block;html=1;" edge="1" parent="1" source="cs" target="lb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lg1" value="WSS" style="endArrow=block;html=1;" edge="1" parent="1" source="lb" target="gw1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lg2" value="WSS" style="endArrow=block;html=1;" edge="1" parent="1" source="lb" target="gw2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g1r" value="adapter + move cmd" style="endArrow=block;startArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="gw1" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2r" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" source="gw2" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3r" style="endArrow=block;startArrow=block;html=1;dashed=1;" edge="1" parent="1" source="gw3" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re1" value="consume moves / publish events" style="endArrow=block;startArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="redis" target="eng1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re2" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" source="redis" target="eng2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rsch" value="due deadlines" style="endArrow=block;startArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="redis" target="sch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eq" value="on game end: enqueue" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="eng1" target="queues"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="qr" style="endArrow=block;startArrow=block;html=1;dashed=1;" edge="1" parent="1" source="queues" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Flow: client move → gateway (authz + Zod) → Redis stream → engine (chess.js truth) → Redis game hash → pub/sub fan-out via Streams adapter → all gateways → clients.&#10;No game state lives in any Node process; killing any pod does not lose a game." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#f5f5f5;strokeColor=#cccccc;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1100" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
