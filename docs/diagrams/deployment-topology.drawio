        <mxCell id="region" value="PRIMARY REGION (private network) — all services + Redis + Postgres primary colocated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;spacingTop=6;fillOpacity=10;dashed=1" vertex="1" parent="1"><mxGeometry x="80" y="330" width="1440" height="640" as="geometry" /></mxCell>

        <mxCell id="web" value="web ×3–4&#10;Next.js RSC/SSR/REST&#10;1 vCPU / 1 GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="380" width="200" height="90" as="geometry" /></mxCell>
