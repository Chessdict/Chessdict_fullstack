      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Deployment Topology — Fly.io/Railway containers + Neon + Upstash/Dragonfly (target 10k CCU, 20k burst)" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="12" width="1000" height="30" as="geometry" /></mxCell>

        <mxCell id="users" value="Users worldwide (browser + wallet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1"><mxGeometry x="620" y="70" width="320" height="50" as="geometry" /></mxCell>
        <mxCell id="cf" value="Cloudflare — CDN · WAF · edge rate-limit · TLS&#10;caches _next/static, images, public pages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="400" height="60" as="geometry" /></mxCell>
