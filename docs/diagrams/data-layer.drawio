<mxfile host="app.diagrams.net" agent="Chessdict-Architecture" version="24.7.0">
  <diagram name="Data Layer" id="data-layer">
    <mxGraphModel dx="1300" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Data Layer — Redis (live/ephemeral) + PostgreSQL (system of record)" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="12" width="840" height="30" as="geometry" /></mxCell>

        <mxCell id="svc" value="Stateless services&#10;web · gateway · engine · matchmaking · workers · scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1"><mxGeometry x="480" y="70" width="520" height="60" as="geometry" /></mxCell>

        <!-- Redis side -->
        <mxCell id="redisbox" value="REDIS / DRAGONFLY (live + ephemeral)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;spacingTop=6;fillOpacity=15" vertex="1" parent="1"><mxGeometry x="60" y="190" width="640" height="470" as="geometry" /></mxCell>
        <mxCell id="rstate" value="Live game state&#10;game:{id} (hash) · game:{id}:moves (list)&#10;maxmemory-policy: never evict live games" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="280" height="80" as="geometry" /></mxCell>
        <mxCell id="rpres" value="Presence&#10;presence:{userId} · activegame:{userId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="290" height="80" as="geometry" /></mxCell>
        <mxCell id="rmm" value="Matchmaking pools&#10;mm:{mode}:{tc} (ZSET) · mm:meta:{userId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="rclock" value="Clocks &amp; locks&#10;clock:{gameId} · lock:game:{id} · lock:signer:{addr}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="290" height="70" as="geometry" /></mxCell>
        <mxCell id="rqueue" value="BullMQ queues + delayed jobs&#10;settlement · rating · persist · notify · clock-timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="radapter" value="Socket.IO Streams adapter&#10;fan-out (trimmed with MAXLEN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="290" height="70" as="geometry" /></mxCell>
        <mxCell id="rcache" value="Read models / cache&#10;leaderboard:{category} (ZSET) · rl:{scope}:{id} · profile cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="590" height="60" as="geometry" /></mxCell>
        <mxCell id="rha" value="HA: 1 primary + replica → Dragonfly or Redis Cluster when ops/sec is the ceiling · AOF everysec · managed backups" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="590" height="50" as="geometry" /></mxCell>

        <!-- Postgres side -->
        <mxCell id="pgbox" value="POSTGRESQL (system of record)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;spacingTop=6;fillOpacity=15" vertex="1" parent="1"><mxGeometry x="760" y="190" width="680" height="470" as="geometry" /></mxCell>
        <mxCell id="pooler" value="Connection Pooler&#10;PgBouncer / Prisma Accelerate / Neon pooler&#10;(N app instances → bounded connections)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="230" width="400" height="70" as="geometry" /></mxCell>
        <mxCell id="pgprimary" value="Primary (writes)&#10;game-end persist · matches&#10;rating updates · outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;boundedLbl=1;backgroundOutline=1;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="pgr1" value="Read replica 1&#10;profiles · history" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;boundedLbl=1;backgroundOutline=1;" vertex="1" parent="1"><mxGeometry x="1040" y="330" width="170" height="120" as="geometry" /></mxCell>
        <mxCell id="pgr2" value="Read replica 2&#10;leaderboard · admin" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;boundedLbl=1;backgroundOutline=1;" vertex="1" parent="1"><mxGeometry x="1240" y="330" width="170" height="120" as="geometry" /></mxCell>
        <mxCell id="pgtables" value="Models: User · Account · Session · Game · OpenChallenge · Tournament · TournamentParticipant · TournamentMatch · SettlementOutbox&#10;Indexes on all FKs + hot query columns · Prisma Migrate (expand/contract, zero-downtime)" style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="610" height="60" as="geometry" /></mxCell>
        <mxCell id="repl" value="streaming replication" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="pgprimary" target="pgr1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="repl2" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="pgprimary" target="pgr2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="s1" value="every move (hot path)" style="endArrow=block;startArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="svc" target="redisbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2" value="game-end / reads (off hot path)" style="endArrow=block;startArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="svc" target="pooler"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pp" style="endArrow=block;html=1;" edge="1" parent="1" source="pooler" target="pgprimary"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
